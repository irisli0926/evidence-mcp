# Copy this file to .env and fill in your values. NEVER commit .env
# (it is listed in .gitignore). This example file must only ever contain
# empty or placeholder values.

# --- Local evidence store -------------------------------------------------------
# Where archived evidence is stored. Relative paths are resolved from the
# directory the server is started in (Claude Desktop uses `uv --directory`).
EVIDENCE_ROOT=./evidence_store

# Largest file that will be downloaded, in megabytes.
MAX_FILE_SIZE_MB=20

# Network timeout for each connect / read operation, in seconds.
HTTP_TIMEOUT_SECONDS=10

# Maximum number of HTTP redirects to follow (every hop is re-validated).
MAX_REDIRECTS=3

# --- Private GitHub provenance index ------------------------------------------
# After a source is saved locally, its metadata (never the file itself) is
# written to records/<evidence_id>.json in this PRIVATE repository.
# Leave these empty to run without GitHub (results then carry the warning
# REMOTE_NOT_CONFIGURED).
#
# Create a fine-grained personal access token with least privilege:
#   Repository access:      Only select repositories -> your evidence-index repo
#   Repository permissions: Contents -> Read and write
# Put the real token ONLY in your local .env file.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
